{
  "env": {
    "browser": true, // 브라우저 환경에서 코드 실행 허용
    "node": true, // Node.js 환경에서 코드 실행 허용
    "es2022": true, // ES2022 문법 지원
  },
  "parser": "@typescript-eslint/parser", // TypeScript 코드 파싱을 위한 파서
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true, // JSX 문법 지원
      "modules": true, // ES 모듈 지원
    },
    "babelOptions": {
      "presets": ["@babel/preset-react"], // Babel React 프리셋 사용
    },
    "project": "./tsconfig.json", // TypeScript 설정 파일 경로
    "sourceType": "module", // ES 모듈 형식 사용
  },
  "extends": [
    // 기본 설정 확장
    "next/core-web-vitals", // Next.js 권장 규칙 및 웹 성능 관련 규칙 포함
    "plugin:import/recommended", // import 문 관련 권장 규칙
    "plugin:import/typescript", // TypeScript import 지원
    "plugin:react/recommended", // React 권장 규칙
    "plugin:react/jsx-runtime", // React 17+ JSX 트랜스폼 지원
    "plugin:@typescript-eslint/recommended", // TypeScript 권장 규칙
    "plugin:tailwindcss/recommended", // Tailwind CSS 권장 규칙
    "plugin:@tanstack/eslint-plugin-query/recommended", // React Query 권장 규칙
    "plugin:react-hooks/recommended", // React Hooks 권장 규칙
    "plugin:jsx-a11y/recommended", // 웹 접근성 권장 규칙
    "prettier", // Prettier와 호환되는 설정
    "plugin:prettier/recommended", // ESLint와 Prettier 통합
  ],
  "globals": {
    "_": true, // lodash를 전역 변수로 사용 허용
  },
  "plugins": [
    "import", // import 문 관련 규칙 제공
    "react", // React 관련 규칙 제공
    "@typescript-eslint", // TypeScript 관련 규칙 제공
    "tailwindcss", // Tailwind CSS 관련 규칙 제공
    "prettier", // Prettier 포맷팅 규칙 제공
    "react-hooks", // React Hooks 관련 규칙 제공
  ],
  "rules": {
    "prettier/prettier": [
      "warn",
      {
        "endOfLine": "auto", // OS에 따른 줄 끝 문자 자동 처리
      },
    ],
    "jsx-a11y/click-events-have-key-events": "off", // 비대화형 요소의 클릭 이벤트에 키보드 이벤트 필수 규칙 비활성화
    "jsx-a11y/no-static-element-interactions": "off", // 비대화형 요소의 이벤트 핸들러 규칙 비활성화
    "react/jsx-key": "warn", // 배열 렌더링 시 key 속성 권장
    "import/no-unresolved": "off", // 모듈 경로 해석 문제 무시
    "no-console": "warn", // console.log 사용 시 경고
    "no-unused-expressions": [
      "error",
      {
        "allowTernary": true, // 삼항 연산자 허용
        "allowShortCircuit": true, // 단축 평가 표현식 허용
        "allowTaggedTemplates": true, // 태그 템플릿 허용
      },
    ],
    "max-nested-callbacks": ["error", 5], // 중첩 콜백 함수 최대 5단계로 제한
    "import/order": [
      "warn",
      {
        "groups": ["builtin", "external", "internal", "parent", "sibling", "index"], // import 그룹 순서 정의
        "pathGroups": [
          {
            "pattern": "@/**",
            "group": "internal", // 내부 모듈로 취급할 패턴 정의
            "position": "after",
          },
        ],
        "alphabetize": {
          "order": "asc", // 알파벳 순으로 정렬
          "caseInsensitive": true, // 대소문자 구분 없이 정렬
        },
      },
    ],
    "react/self-closing-comp": [
      "error",
      {
        "component": true, // 컴포넌트 자체 닫기 태그 강제
        "html": true, // HTML 요소도 자체 닫기 태그 강제
      },
    ],
    "react/react-in-jsx-scope": "off", // React 17+ 에서는 import React 불필요
    "react/jsx-filename-extension": [1, { "extensions": [".js", ".jsx", ".ts", ".tsx"] }], // JSX 사용 가능한 파일 확장자
    "@typescript-eslint/no-unused-vars": ["warn"], // 사용하지 않는 변수 경고
    "@typescript-eslint/no-shadow": ["warn"], // 변수명 섀도잉 경고
    "@typescript-eslint/explicit-module-boundary-types": "off", // 함수 반환 타입 명시 규칙 비활성화
    "tailwindcss/classnames-order": "warn", // Tailwind 클래스명 순서 권장
    "tailwindcss/enforces-shorthand": "warn", // Tailwind 단축형 권장
    "tailwindcss/no-custom-classname": "warn", // 커스텀 클래스명 사용 경고
    "@typescript-eslint/no-explicit-any": "warn", // any 타입 사용 시 경고
    "@typescript-eslint/explicit-function-return-type": "off", // 함수 반환 타입 명시 규칙 비활성화
    "@typescript-eslint/consistent-type-imports": [
      "warn",
      {
        "prefer": "type-imports", // type import 사용 권장
        "fixStyle": "inline-type-imports", // 자동 수정 스타일
      },
    ],
    "react/prop-types": "off", // TypeScript를 사용하므로 prop-types 불필요
  },
  "settings": {
    "react": {
      "version": "detect", // React 버전 자동 감지
    },
    "import/resolver": {
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx"], // 해석 가능한 확장자 목록
        "moduleDirectory": ["node_modules", "."], // 모듈 찾을 디렉토리
      },
      "typescript": {}, // TypeScript 모듈 해석 활성화
    },
    "tailwindcss": {
      "callees": ["classnames", "clsx", "ctl"], // 클래스명 유틸리티 함수 목록
    },
  },
  "overrides": [
    // 특정 파일에 다른 규칙 적용
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "next.config.mjs", "**/*.stories.*"], // 테스트 및 설정 파일
      "rules": {
        "no-unused-expressions": "off", // 테스트에서 unused expressions 허용
        "@typescript-eslint/no-explicit-any": "off", // 테스트에서 any 타입 허용
        "import/no-anonymous-default-export": "off", // 이름 없는 기본 내보내기 허용
      },
    },
  ],
}
